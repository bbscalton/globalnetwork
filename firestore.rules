rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isFounder() {
      return signedIn() && request.auth.token.email == 'neuereatec@gmail.com';
    }
    function memberRole() {
      return get(/databases/$(database)/documents/deskMembers/$(request.auth.uid)).data.role;
    }
    function isOwner() {
      return isFounder()
        || (signedIn() && request.auth.token.owner == true)
        || (signedIn()
          && exists(/databases/$(database)/documents/deskMembers/$(request.auth.uid))
          && memberRole() == 'owner');
    }
    function isManager() {
      return isOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/deskMembers/$(request.auth.uid))
          && memberRole() == 'manager');
    }
    function isPosStaff() {
      return isManager()
        || (signedIn()
          && exists(/databases/$(database)/documents/deskMembers/$(request.auth.uid))
          && memberRole() == 'cashier');
    }
    function customerOwns(customerId) {
      return signedIn() && (
        get(/databases/$(database)/documents/customers/$(customerId)).data.uid == request.auth.uid
        || customerId == request.auth.uid
      );
    }
    function customerApproved(customerId) {
      let d = get(/databases/$(database)/documents/customers/$(customerId)).data;
      return !('approvalStatus' in d) || d.approvalStatus == 'approved';
    }

    match /staffProfiles/{uid} {
      allow read, write: if false;
    }

    match /deskMembers/{uid} {
      allow read: if isManager() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /deskInvites/{email} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /orgs/{orgId} {
      allow read: if isPosStaff();
      allow write: if isOwner();
    }

    match /posOutlets/{outletId} {
      allow read: if isPosStaff();
      allow create, update, delete: if isManager();
    }

    match /plans/{planId} {
      // Public catalog for the marketing site; only owners edit in the Plans desk.
      allow read: if true;
      allow write: if isOwner();
    }

    match /adminConfig/{doc} {
      // Omada passwords/secrets are Admin SDK only (saveOmadaConfig). Never client getDoc.
      allow read, write: if isOwner() && doc != 'omadaEr7206';
    }

    match /adminAuditLogs/{id} {
      allow read, create: if isOwner();
      allow update, delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isPosStaff() || customerOwns(customerId);
      allow create: if isOwner();
      allow update: if (isOwner()
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['paidUntilMs', 'graceUntilMs', 'status', 'balanceDue', 'paidAmount']))
        || (customerOwns(customerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenMs', 'fcmToken', 'uid']));
      allow delete: if isOwner();

      match /payments/{payId} {
        allow read: if isPosStaff() || customerOwns(customerId);
        allow write: if false;
      }

      match /chatMessages/{msgId} {
        allow read: if isOwner() || customerOwns(customerId);
        allow create: if isOwner()
          || (customerOwns(customerId) && customerApproved(customerId)
            && request.resource.data.keys().hasAll(['from', 'text', 'createdAtMs']));
        allow update, delete: if isOwner();
      }

      match /issues/{issueId} {
        allow read: if isOwner() || customerOwns(customerId);
        allow create, update: if isOwner() || (customerOwns(customerId) && customerApproved(customerId));
        allow delete: if isOwner();
      }

      match /calls/{callId} {
        allow read: if isOwner() || customerOwns(customerId);
        allow create: if customerOwns(customerId) && customerApproved(customerId)
          && request.resource.data.from == 'customer'
          && request.resource.data.status == 'ringing'
          && request.resource.data.keys().hasAll(['from', 'status', 'offerSdp', 'startedAtMs']);
        allow update: if isOwner()
          || (customerOwns(customerId) && customerApproved(customerId)
            && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['recordingUrl', 'recording', 'answeredAtMs', 'ownerVideoVisible']));
        allow delete: if isOwner();

        match /iceOffer/{iceId} {
          allow read: if isOwner() || customerOwns(customerId);
          allow create: if customerOwns(customerId) && customerApproved(customerId)
            && request.resource.data.keys().hasAll(['candidate']);
          allow update, delete: if false;
        }
        match /iceAnswer/{iceId} {
          allow read: if isOwner() || customerOwns(customerId);
          allow create: if (isOwner() || (customerOwns(customerId) && customerApproved(customerId)))
            && request.resource.data.keys().hasAll(['candidate']);
          allow update, delete: if false;
        }
      }
    }
  }
}
