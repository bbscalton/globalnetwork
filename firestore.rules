rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'neuereatec@gmail.com';
    }
    function customerOwns(customerId) {
      return signedIn() && (
        get(/databases/$(database)/documents/customers/$(customerId)).data.uid == request.auth.uid
        || customerId == request.auth.uid
      );
    }

    match /staffProfiles/{uid} {
      allow read, write: if false;
    }

    match /orgs/{orgId} {
      allow read, write: if isOwner();
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /adminConfig/{doc} {
      allow read, write: if isOwner();
    }

    match /adminAuditLogs/{id} {
      allow read, create: if isOwner();
      allow update, delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isOwner() || customerOwns(customerId);
      allow create: if isOwner();
      allow update: if (isOwner()
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['paidUntilMs', 'graceUntilMs', 'status', 'balanceDue', 'paidAmount']))
        || (customerOwns(customerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenMs', 'fcmToken', 'uid']));
      allow delete: if isOwner();

      match /payments/{payId} {
        allow read: if isOwner() || customerOwns(customerId);
        allow write: if false;
      }

      match /chatMessages/{msgId} {
        allow read: if isOwner() || customerOwns(customerId);
        allow create: if (isOwner() || customerOwns(customerId))
          && request.resource.data.keys().hasAll(['from', 'text', 'createdAtMs']);
        allow update, delete: if isOwner();
      }

      match /issues/{issueId} {
        allow read: if isOwner() || customerOwns(customerId);
        allow create: if isOwner() || customerOwns(customerId);
        allow update: if isOwner() || customerOwns(customerId);
        allow delete: if isOwner();
      }
    }
  }
}
